#!/usr/bin/env bash
# Repo policy check. Installed as both pre-commit and commit-msg.
#   pre-commit:  staged paths, staged content, author/committer identity
#   commit-msg:  commit message text
set -euo pipefail

# Bracketed so this file does not match itself.
PATTERN='c[l]aude|a[n]thropic|co-authored-b[y]|generated wit[h]|\bll[m]\b|\ba[i]\b'
ALLOWED='generated by recomp/emit\.py'
IDENT='Akhil Moola <goudakhil29@gmail.com>'

fail() { echo "policy: $*" >&2; exit 1; }

scan() {
    # stdin: text to check; $1: label
    local hits
    hits=$(sed -E "s#${ALLOWED}##Ig" | grep -inE "$PATTERN" || true)
    [ -z "$hits" ] || fail "$1 matches blocked pattern:"$'\n'"$hits"
}

mode=$(basename "$0")

if [ "$mode" = "commit-msg" ]; then
    grep -v '^#' "$1" | scan "commit message"
    exit 0
fi

# Identity
for var in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    who=$(git var "$var" | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')
    [ "$who" = "$IDENT" ] || fail "$var is '$who', expected '$IDENT'"
done

# Paths
staged=$(git diff --cached --name-only --diff-filter=ACMR)
bad=$(printf '%s\n' "$staged" | grep -E '(^|/)(C[L]AUDE\.md|CT_WORKFLOW\.md|KICKOFF[^/]*\.md|\.c[l]aude/|notes/|SESSION[^/]*\.md)' || true)
[ -z "$bad" ] || fail "ignored local file staged:"$'\n'"$bad"
bad=$(printf '%s\n' "$staged" | grep -iE '\.(sfc|smc)$' || true)
[ -z "$bad" ] || fail "ROM file staged:"$'\n'"$bad"
printf '%s\n' "$staged" | scan "staged path"

# Content (added lines only)
git diff --cached -U0 --no-color --diff-filter=ACMR \
    | grep -E '^\+' | grep -vE '^\+\+\+ ' | scan "staged content"

exit 0
